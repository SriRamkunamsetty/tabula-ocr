# Copy to .env for local development. All keys are optional; sensible
# defaults live in src/tabula_ocr/config.py.

TABULA_ENVIRONMENT=dev
TABULA_LOG_LEVEL=INFO
TABULA_LOG_FORMAT=console

# Point at a provisioned MI300X vLLM endpoint (see deploy/provision_mi300x.sh)
TABULA_VLM_BASE_URL=http://localhost:8000/v1
TABULA_VLM_MODEL=PaddlePaddle/PaddleOCR-VL
TABULA_VLM_API_KEY=EMPTY

TABULA_PASSES=2
TABULA_ABSTAIN_BELOW=0.62
TABULA_GPU_HOURLY_RATE_USD=1.99
TABULA_MEASURED_TOKENS_PER_S=1400
